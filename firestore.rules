rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write to access_settings and gestores_credentials
    match /access_settings/{settingId} {
      allow read, write: if true;
    }
    match /gestores_credentials/{gestorId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
